<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create table tgb_users" author="oress">
        <createTable tableName="tgb_users">
            <column name="tg_id" type="bigint">
                <constraints primaryKey="true" nullable="true" unique="true"/>
            </column>
            <column name="role" type="text"/>

            <!-- Can be null for administrators -->
            <column name="mt5_acc_number" type="bigint" />
            <column name="mt5_acc_pwd_enc" type="bytea" />

            <column name="invited_by" type="bigint"/>
            <column name="disabled" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="disabled_reason" type="text" />
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_user_invited_by"
                                 baseTableName="tgb_users"
                                 baseColumnNames="invited_by"
                                 referencedTableName="tgb_users"
                                 referencedColumnNames="tg_id"/>
    </changeSet>

    <changeSet id="create indexes for tgb_users" author="oress">
        <createIndex indexName="idx_tgb_users_mt5_acc_number" tableName="tgb_users">
            <column name="mt5_acc_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="create table tgb_invite_links" author="oress">
        <createTable tableName="tgb_invite_links">
            <column name="code" type="text">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tg_userid_for" type="bigint">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="role_on_accept" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="mt5_acc_number" type="bigint" />
            <column name="mt5_acc_pwd_enc" type="bytea" />
            <column name="created_by" type="bigint" />
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_tgb_invite_links_created_by"
                                 baseTableName="tgb_invite_links"
                                 baseColumnNames="created_by"
                                 referencedTableName="tgb_users"
                                 referencedColumnNames="tg_id"/>
    </changeSet>

    <changeSet id="create indexes for tgb_invite_links" author="oress">
        <createIndex indexName="idx_tgb_invite_links_mt5_acc_number" tableName="tgb_invite_links">
            <column name="mt5_acc_number"/>
        </createIndex>
        <createIndex indexName="idx_tgb_invite_links_tg_userid_for" tableName="tgb_invite_links">
            <column name="tg_userid_for"/>
        </createIndex>
    </changeSet>

    <changeSet id="create table tgb_orders" author="oress">
        <createTable tableName="tgb_orders">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint" />
            <column name="city" type="text" />
            <column name="deal" type="text" />
            <column name="order" type="text" />
            <column name="volume" type="decimal(19,6)" />
            <column name="price" type="decimal(19,6)" />
            <column name="bid" type="decimal(19,6)" />
            <column name="ask" type="decimal(19,6)" />
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_tgb_orders_user_id"
                                 baseTableName="tgb_orders"
                                 baseColumnNames="user_id"
                                 referencedTableName="tgb_users"
                                 referencedColumnNames="tg_id"/>
    </changeSet>

    <changeSet id="add type and euro_amount columns to tgb_orders" author="oress">
        <addColumn tableName="tgb_orders">
            <column name="type" type="text"/>
            <column name="instrument" type="text"/>
            <column name="acc_number" type="bigint"/>
            <column name="euro_amount" type="decimal(19,6)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>