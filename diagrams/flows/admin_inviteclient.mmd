flowchart TD
    START(["/inviteclient"])
    SHARE_CONTACT(["SHARE_CONTACT"])
    PRESENT_CLIENT(["PRESENT_CLIENT"])
    ACCOUNT_CREDENTIALS(["ACCOUNT_CREDENTIALS"])
    INVALID_CREDENTIALS(["INVALID_CREDENTIALS"])
    GENERATE_INVITE(["GENERATE_INVITE"])
    END(["END"])

    START --> SHARE_CONTACT
    SHARE_CONTACT --> |This client is already registered| PRESENT_CLIENT
    SHARE_CONTACT --> |New client| ACCOUNT_CREDENTIALS
    SHARE_CONTACT --> |/cancel| END
    SHARE_CONTACT --> |garbage| SHARE_CONTACT
    ACCOUNT_CREDENTIALS --> |Invalid broker account credentials or garbage| INVALID_CREDENTIALS
    INVALID_CREDENTIALS --> |Prompt again| ACCOUNT_CREDENTIALS
    ACCOUNT_CREDENTIALS --> |Credentials are OK| GENERATE_INVITE
    ACCOUNT_CREDENTIALS --> |/cancel| END
    GENERATE_INVITE --> END
    PRESENT_CLIENT --> END