    <changeSet id="add fk_order_consumption_consumed_order" author="oress">
        <addForeignKeyConstraint
                constraintName="fk_order_consumption_consumed_order"
                baseTableName="hed_lifo_position_consumptions"
                baseColumnNames="consumed_position_id"
                referencedTableName="hed_lifo_positions"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="add idx_hed_lifo_position_consumptions_parent_order" author="oress">
        <createIndex indexName="idx_hed_lifo_position_consumptions_parent_order" tableName="hed_lifo_position_consumptions">
            <column name="parent_order_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add idx_hed_lifo_position_consumptions_consumed_order" author="oress">
        <createIndex indexName="idx_hed_lifo_position_consumptions_consumed_order" tableName="hed_lifo_position_consumptions">
            <column name="consumed_position_id"/>
        </createIndex>
