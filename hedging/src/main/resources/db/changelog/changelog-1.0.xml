        </createIndex>
    </changeSet>

    <changeSet id="create fk_hed_lifo_positions_order_id" author="oress">
        <addForeignKeyConstraint constraintName="fk_hed_lifo_positions_order_id"
                                 baseTableName="hed_lifo_positions"
                                 baseColumnNames="order_id"
                                 referencedTableName="hed_orders"
                                 referencedColumnNames="id" />
