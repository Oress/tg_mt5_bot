    </changeSet>

    <changeSet id="create hed_user_balance_actions" author="oress">
        <createSequence sequenceName="seq_hed_user_balance_actions"
                        dataType="int"
                        incrementBy="1"
                        startValue="1"/>

        <createTable tableName="hed_user_balance_actions">
            <column name="id" type="bigint">
