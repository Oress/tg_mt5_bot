<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create table hed_users" author="oress">
        <createTable tableName="hed_users">
            <column name="tg_id" type="bigint">
                <constraints primaryKey="true" nullable="true" unique="true"/>
            </column>
            <column name="role" type="text"/>

            <!-- Can be null for administrators -->
            <column name="mt5_acc_number" type="bigint" />
            <column name="mt5_acc_pwd_enc" type="bytea" />

            <column name="username" type="text"/>
            <column name="language_code" type="text"/>
            <column name="first_name" type="text"/>
            <column name="ggl_sheet_id" type="text"/>
            <column name="account_type" type="text"/>

            <column name="disabled" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="disabled_reason" type="text" />
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="create indexes for hed_users" author="oress">
        <createIndex indexName="idx_hed_users_mt5_acc_number" tableName="hed_users">
            <column name="mt5_acc_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="create table hed_instruments" author="oress">
        <createTable tableName="hed_instruments">
            <column name="label" type="text">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="symbol_zero" type="text" />
            <column name="symbol_mini" type="text" />
            <column name="symbol_standard" type="text" />
            <column name="base" type="text" />
            <column name="quote" type="text" />
            <column name="mode" type="text" />
            <column name="sheet_id" type="int" />
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="create seq seq_hed_users_sheet_id" author="oress">
        <createSequence sequenceName="seq_hed_users_sheet_id"
                        dataType="int"
                        incrementBy="1"
                        startValue="1"/>
    </changeSet>

    <changeSet id="create seq_hed_user_instruments" author="oress">
        <createSequence sequenceName="seq_hed_user_instruments"
                        dataType="int"
                        incrementBy="1"
                        startValue="1"/>
    </changeSet>

    <changeSet id="create table hed_user_instruments" author="oress">
        <createTable tableName="hed_user_instruments">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint" />
            <column name="instrument_label" type="text" />
            <column name="sheet_id" type="int" defaultValue="nextval('seq_hed_users_sheet_id')" />

            <column name="client_owned_quote_amount" type="decimal(20,8)" />
            <column name="house_owned_base_amount" type="decimal(20,8)" />
            <column name="client_owned_base_amount" type="decimal(20,8)"/>
<!--            <column name="total_owned_base_amount" type="decimal(20,8)" />-->

            <column name="created_at" type="TIMESTAMP" defaultValue="now()"/>
            <column name="active" type="boolean"/>
        </createTable>
    </changeSet>

    <changeSet id="create idx_hed_user_instruments_user_id" author="oress">
        <createIndex tableName="hed_user_instruments" indexName="idx_hed_user_instruments_user_id">
            <column name="user_id" />
        </createIndex>
    </changeSet>

    <changeSet id="create idx_hed_user_instruments_instrument_label" author="oress">
        <createIndex tableName="hed_user_instruments" indexName="idx_hed_user_instruments_instrument_label">
            <column name="instrument_label" />
        </createIndex>
    </changeSet>

    <changeSet id="create fk_hed_user_instruments_instrument_label" author="oress">
        <addForeignKeyConstraint constraintName="fk_hed_user_instruments_instrument_label"
                                 baseTableName="hed_user_instruments"
                                 baseColumnNames="instrument_label"
                                 referencedTableName="hed_instruments"
                                 referencedColumnNames="label" />
    </changeSet>

    <changeSet id="create fk_hed_user_instruments_user_id" author="oress">
        <addForeignKeyConstraint constraintName="fk_hed_user_instruments_user_id"
                                 baseTableName="hed_user_instruments"
                                 baseColumnNames="user_id"
                                 referencedTableName="hed_users"
                                 referencedColumnNames="tg_id" />
    </changeSet>

    <changeSet id="insert EUR/USD instrument" author="oress">
        <insert tableName="hed_instruments">
            <column name="label" value="EUR/USD" />
            <column name="symbol_zero" value="EURUSDz" />
            <column name="symbol_mini" value="EURUSDm" />
            <column name="symbol_standard" value="EURUSD" />
            <column name="base" value="EUR" />
            <column name="quote" value="USD" />
            <column name="mode" value="SHORT" />
            <column name="sheet_id" value="10" />
            <column name="created_at" value="now()"/>
        </insert>
    </changeSet>

    <changeSet id="insert USD/CAD instrument" author="oress">
        <insert tableName="hed_instruments">
            <column name="label" value="USD/CAD" />
            <column name="symbol_zero" value="USDCADz" />
            <column name="symbol_mini" value="USDCADm" />
            <column name="symbol_standard" value="USDCAD" />
            <column name="base" value="USD" />
            <column name="quote" value="CAD" />
            <column name="mode" value="LONG" />
            <column name="sheet_id" value="11" />
            <column name="created_at" value="now()"/>
        </insert>
    </changeSet>

    <changeSet id="create table hed_orders" author="oress">
        <createTable tableName="hed_orders">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_instrument_id" type="bigint" />
            <column name="city" type="text" />
            <column name="deal" type="bigint" />
            <column name="mt5_order" type="bigint" />
            <column name="type" type="text"/>
            <column name="status" type="text"/>
            <column name="acc_number" type="bigint"/>

            <column name="user_entered_quote_amount" type="decimal(20,8)"/>
            <column name="executed_base_amount" type="decimal(20,8)"/>
            <column name="user_base_amount" type="decimal(20,8)"/>
            <column name="executed_volume" type="decimal(20,8)" />

            <column name="quote_amount_left_to_unhedge" type="decimal(20,8)"/>

            <column name="house_base_amount_from" type="decimal(20,8)" />
            <column name="house_base_amount_to" type="decimal(20,8)" />
            <column name="client_base_amount_from" type="decimal(20,8)" />
            <column name="client_base_amount_to" type="decimal(20,8)" />

            <column name="price" type="decimal(20,8)" />
            <column name="bid" type="decimal(20,8)" />
            <column name="ask" type="decimal(20,8)" />
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_hed_orders_user_id"
                                 baseTableName="hed_orders"
                                 baseColumnNames="user_instrument_id"
                                 referencedTableName="hed_user_instruments"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="add idx_hed_orders_created_at to hed_orders" author="oress">
        <createIndex indexName="idx_hed_orders_created_at" tableName="hed_orders">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="create seq_hed_order_consumption" author="oress">
        <createSequence sequenceName="seq_hed_order_consumption"
                        dataType="bigint"
                        incrementBy="1"
                        startValue="1"/>
    </changeSet>

    <changeSet id="create hed_order_consumption" author="oress">
        <createTable tableName="hed_order_consumption">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="parent_order_id" type="uuid" />
            <column name="consumed_order_id" type="uuid" />
            <column name="consumed_quote_amount" type="decimal(20,8)" />
            <column name="left_quote_amount" type="decimal(20,8)" />
            <column name="base_equivalent" type="decimal(20,8)" />
        </createTable>
    </changeSet>

    <changeSet id="add fk_order_consumption_parent_order" author="oress">
        <addForeignKeyConstraint
                constraintName="fk_order_consumption_parent_order"
                baseTableName="hed_order_consumption"
                baseColumnNames="parent_order_id"
                referencedTableName="hed_orders"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="add fk_order_consumption_consumed_order" author="oress">
        <addForeignKeyConstraint
                constraintName="fk_order_consumption_consumed_order"
                baseTableName="hed_order_consumption"
                baseColumnNames="consumed_order_id"
                referencedTableName="hed_orders"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="add idx_order_consumption_parent_order" author="oress">
        <createIndex indexName="idx_order_consumption_parent_order" tableName="hed_order_consumption">
            <column name="parent_order_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add idx_order_consumption_consumed_order" author="oress">
        <createIndex indexName="idx_order_consumption_consumed_order" tableName="hed_order_consumption">
            <column name="consumed_order_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add idx_order_consumption_amount" author="oress">
        <createIndex indexName="idx_order_consumption_amount" tableName="hed_order_consumption">
            <column name="consumed_quote_amount"/>
        </createIndex>
    </changeSet>

    <changeSet id="create hed_user_telegram_activity" author="oress">
        <createSequence sequenceName="seq_hed_user_telegram_activity"
                        dataType="int"
                        incrementBy="1"
                        startValue="1"/>

        <createTable tableName="hed_user_telegram_activity">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint" />
            <column name="current_user_state" type="text" />
            <column name="type" type="text" />
            <column name="message_id" type="text" />
            <column name="data" type="text" />
            <column name="created_at" type="timestamp" />
        </createTable>
    </changeSet>

    <changeSet id="create idx_hed_user_telegram_activity_user_id" author="oress">
        <createIndex indexName="idx_hed_user_telegram_activity_user_id" tableName="hed_user_telegram_activity">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create idx_hed_user_telegram_activity_created_at" author="oress">
        <createIndex indexName="idx_hed_user_telegram_activity_created_at" tableName="hed_user_telegram_activity">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>